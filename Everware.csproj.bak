<Project Sdk="Tomat.Terraria.ModLoader.Sdk/2.1.1">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" />

	<!-- General -->
	<PropertyGroup>
		<TmlBuildBootstrapFeatures>tomat.assethotreloading;tomat.enablemod;lolxd87.splashskip</TmlBuildBootstrapFeatures>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />
	<ItemGroup>
		<Reference Include="Daybreak">
			<HintPath>Daybreak.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Assets\Effects\Meteor\" />
	</ItemGroup>

	<!-- References -->

</Project>