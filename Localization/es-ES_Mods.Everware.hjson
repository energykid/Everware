		DisplayName: Estatua de Estrella de Cristal
		Tooltip: Al ser cableada, hace aparecer una [c/AA95E1:Estrella de Poder] que aumenta tu velocidad de ataque mágico pero reduce tu daño mágico
	}

	PowerStar.DisplayName: Estrella de Poder

	GreatGargoyle: {
		DisplayName: Gran Gárgola
		Tooltip:
			'''
			Golpear enemigos carga el [c/A3FF33:Medidor de Carga]
			Al llenarse el medidor, has <right> para despertar a la Gárgola
			Esto daña y marca a los enemigos cercanos, aumentando el daño cuerpo a cuerpo y de invocación
			'''
		SummonDamage: de daño por invocación al despertar
	}

	MasterLockpick: {
		DisplayName: Ganzúa Maestra
		Tooltip:
			'''
			Desbloquea los cofres de Oro y Acero al usarse
			'¡Buena para abrir candados maestros!'
			'''
	}

