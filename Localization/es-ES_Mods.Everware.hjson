	MagmaticAmmokit: {
		DisplayName: Kit Magmático de Munición
		Tooltip:
			'''
			Aumenta tu probabilidad de ataque crítico a distancia en 5% 
			Ataques críticos a distancia crean una explosión que golpea detrás del enemigo
			'''
	}

	Whetstone: {
		DisplayName: Piedra de Afilar
		Tooltip:
			'''
			Permite bloquar proyectiles con armas cuerpo a cuerpo
			Al bloquear con proyectil, gana un 20% de velocidad cuerpo a cuerpo
			Enfríamiento de 10 segundos
			'''
	}

	DichromaticSkull: {
		DisplayName: Calavera Dicromática
		Tooltip:
			'''
			Facing left will shoot lingering, defense-reducing bubbles
			Facing right will shoot a mid-range burst of fire
			Enemies afflicted with both debuffs will take extra damage
			'''
	}

	AtlasCrown: {
		DisplayName: Corona de Atlas
		Tooltip:
			'''
			Cuando no estés atacando, mantén ARRIBA para invocar gradualemente trozos del suelo
			Atacar los disparará a tu cursor Attacking will unleash them towards your cursor
			El tamaño, daño y frecuencia de los trozos invocados dependen de la velocidad de ataque de tu arma
			'''
	}

