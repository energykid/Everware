NPCs: {
	Snapdragon.DisplayName: Snapdragon

	SculptorNPC: {
		DisplayName: Escultor
		Reliquary: Relicaro
		Chisel: Cincel
		BestiaryEntry: This lonesome master artist has made his home in an underground gallery of ice sculptures, where he's explored and searched for inspiration for decades.

		Dialogue: {
			Greeting: {
				One: ¿Quien es el que va dejando todas esas estatuas de murciélago por aquí, de todas formas? Que cosa tan rara de esculpir quince veces distintas.
				Two: Perdí mi cincel en algún sitio y no lo encuentro. ¿Lo has visto por algún lado en el hielo?
				Three: Solía hacer esculturas de piedra en la jungla, ¡Pero me las robaban cada vez que volteaba la mirada!
				Four: Sé que has estado encontrando estatuas por doquier, pero porfavor, trátalas con cuidado con ese pico tuyo. ¡Las vas a dañar!
				Five: Sabes, algúnas de las piezas que la gente me muestra son algo .... simples. Pudiera añadirles mi toque, si quisieras.
				Six: ¿Oh, la de esqueleto? Esa no fuí yo. De verdad, no es mía ¿Porqué preguntas?
			}

			TradeGreeting: {
				One: ¡Múestrame una estatua y veré que puedo hacer!
				Two: Está bien, déjame agarrar mis herramientas...
				Three: ¿Otra colaboración? ¡Esplendido!
			}

			NoStatue: {
				One: No hay estatua que cincelar, amigo
				Two: No parece que tengas una estatua lista
				Three: ¿Vas a traer una estatua?
			}

			InvalidStatue: {
				One: No puedo hacer nada con esta
				Two: No creo que pueda salvar a esta.
				Three: No puedo mejorar este diseño.
			}

			AngelStatue: {
				One: ¿Quién siquiera hizo esto?
				Two: Puedo estar ido, ¿pero de verdad me vez como un bárbaro?
				Three: ¿Quién crees que soy, un pastor?
			}

			NoMaterial: {
				One: Tengo una idea, pero necesito materiales.
				Two: Una buena base, ¡pero voy a necesitar un toque extra!
				Three: ¡Sabes que no me gusta trabajar con un solo color!
			}

			WrongMaterial: {
				One: No, no, eso no es lo que te pedí.
				Two: ¡Me trajiste los materiales que no eran!
				Three: ¿Qué es esto que me has traído?
			}

			NotEnoughMaterial: {
				One: Necesito un poco más de este material.
				Two: Quisiera asegurarme que no me quedaré sin materiales.
				Three: Hmm, necesitaré un poco más de nuestro color secundario.
			}

			SculptAnimation: {
				One: Hmm, aquí voy...
				Two: Vamos a ver...
				Three: Un poquito aquí, un poquito allá...
			}

			SculptAnimationFinished: {
				One: Y.. ¡Listo! ¡Disfrútalo!
				Two: ¡Sí, esto es mejor!
				Three: ¡Esto me gusta más!
			}

			TooManyStatues: {
				One: ¡Bájale a la velocidad, no puedo hacer múltiples piezas a la vez!
				Two: ¡No soy multitareas, amigo!
				Three: ¡Hay muchas estatuas ahí, por favor dame sólo una!
			}
		}

		TownNPCMood: {
			Content: Estoy bien.
			NoHome: Odio no tener una casa.
			FarFromHome: Estoy muy lejos de casa.
			LoveSpace: Me encanta tener tanto espacio.
			DislikeCrowded: No me gusta este gentío.
			HateCrowded: Odio este gentío.
			// LoveBiome: Ah, {BiomeName}! Great place to be!
			// LikeBiome: I'm a fan of {BiomeName}. Nice place to work.
			// DislikeBiome: ...{BiomeName}... Bad climate for masonry.
			// HateBiome: I can't stay in {BiomeName}. My work keeps getting stolen there!
			// LoveNPC: I love working with {NPCName}! Perhaps he may be up for collaboration again soon?
			// LikeNPC: You know, {NPCName} isn't so bad. Seems to appreciate my work, too!
			// DislikeNPC: Ergh... {NPCName}. I'd prefer not to work around them.
			// HateNPC: For having such an exquisite beard, {NPCName} has NO taste in art!
			LikeNPC_Princess: Me agrada {NPCName}.
			Princess_LovesNPC: Me agrada {NPCName}.
		}
	}
}

