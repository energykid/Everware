	ShardShredder: {
		DisplayName: Triturador de Fragmentos
		Tooltip:
			'''
			<right> para insertar hielo en la ametralladora
			Al disparar, la ametralladora se congelará rápidamente y convertirá pequeños fragmentos de hielo en grandes trozos, aumentando el daño
			Después de un rato, se quedará sin hielo
			'''
	}

	CrystalHeartStatueItem: {
		DisplayName: Estatua de Corazón de Cristal
		Tooltip: Al ser cableada, hace aparecer un [c/E295B7:Corazón de Poder], que cura 60 puntos de vida en 5 segundos
	}

	PowerHeart.DisplayName: Corazón de Poder

