		DisplayName: Madeira Envelhecida
		Tooltip: ""
	}

	KilnstoneWall: {
		DisplayName: Parede de Pedra de Forno
		Tooltip: ""
	}

	ShardShredder: {
		DisplayName: Triturador de Estilhaços
		Tooltip:
			'''
			Clique com o botão direito para inserir gelo na metralhadora
			Ao disparar, a metralhadora resfriará rapidamente e converterá pequenos pedaços de gelo em grandes estilhaços para causar dano adicional
			Depois de um tempo, no entanto, o gelo ainda acabará
			'''
	}

	CrystalHeartStatueItem: {
		DisplayName: Estátua de Coração de Cristal
		Tooltip: Quando ativada por um fio, gera um [c/E295B7:Coração do Poder] que restaura 60 de vida ao longo de 5 segundos
	}

	PowerHeart.DisplayName: Coração do Poder

	CrystalStarStatueItem: {
		DisplayName: Estátua de Estrela de Cristal
		Tooltip: Quando ativada por um fio, gera uma [c/AA95E1:Estrela do Poder] que aumenta consideravelmente a velocidade dos seus ataques mágicos, mas reduz o dano mágico
	}

	PowerStar.DisplayName: Estrela do Poder

	GreatGargoyle: {
		DisplayName: Grande Gárgula
		Tooltip:
			'''
			Atingir inimigos acumula seu [c/A3FF33:Medidor de Carga]
			Com o medidor cheio, clique com o botão direito para despertar a Gárgula
			Isso causa dano e marca inimigos próximos, aumentando o dano corpo a corpo e de invocação causado a eles
			'''
		SummonDamage: dano de invocação ao despertar
	}

	MasterLockpick: {
		DisplayName: Gazua Mestra
		Tooltip:
			'''
			Destranca baús de ouro e aço ao ser brandida
			'Ótima para abrir fechaduras mestras!'
			'''
	}

	SteelChestItem: {
		DisplayName: Baú de Aço
		Tooltip: ""
	}

	MagmaticAmmokit: {
		DisplayName: Kit de Munição Magmática
		Tooltip:
			'''
			+5% de chance de acerto crítico à distância
			Acertos críticos à distância criam uma explosão que atinge atrás do inimigo
			'''
	}

	Whetstone: {
		DisplayName: Pedra de Afiar
		Tooltip:
			'''
			Permite ripostar projéteis usando armas corpo a corpo
			Ao ripostar um projétil com sucesso, concede +20% de velocidade corpo a corpo
			10 segundos de recarga
			'''
	}

	DichromaticSkull: {
		DisplayName: Caveira Dicromática
		Tooltip:
			'''
			Olhar para a esquerda dispara bolhas persistentes que reduzem a defesa
			Olhar para a direita dispara uma rajada de fogo de médio alcance
			Inimigos afetados por ambos os efeitos negativos recebem dano adicional
			'''
	}

	AtlasCrown: {
		DisplayName: Coroa de Atlas
		Tooltip:
			'''
			Enquanto não estiver atacando, segure CIMA para invocar gradualmente aglomerados do chão
			Atacar os lança em direção ao cursor
			O tamanho, dano e frequência dos aglomerados invocados dependem da velocidade de ataque da arma empunhada
			'''
	}

	GravelItem: {
		DisplayName: Cascalho
		Tooltip: ""
	}

	ChiselRecipeCondition: Cinzelado pelo Escultor
	Hits: Acertos
	Times: vezes
	AnyCopperBar: Qualquer Barra de Cobre
