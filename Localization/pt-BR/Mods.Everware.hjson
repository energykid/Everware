	BloodRubyCharm: {
		DisplayName: Rubi do Diabo
		Tooltip:
			'''
			Double tap a direction to dash, creating a damaging explosion behind you
			Dashing also briefly stops you from falling
			'''
	}

	Pyrocleavers: {
		DisplayName: Cutelos Pirotécnicos
		Tooltip:
			'''
			Arremessa cutelos derretidos que se fundem ao chão, deixando lava persistente
			Ao atingir uma parede, os cutelos ricocheteiam
			'''
	}

	SkullStaff: {
		DisplayName: Cajado da Caveira de Obsidiana
		Tooltip:
			'''
			Invoca uma caveira de obsidiana aterrorizante, risonha e gritante que explode ao contato
			Regenera pouco depois de atingir um inimigo
			'''
	}

	HotShot: {
		DisplayName: Tiro Quente
		Tooltip:
			'''
			Clique com o botão direito para bombear, aumentando a quantidade e a velocidade das balas enquanto reduz a dispersão
			Bombear três vezes consecutivas antes de disparar maximiza sua carga e causa um forte recuo ao atacar
			'''
	}

	UnwieldyStaff: {
		DisplayName: Cajado Desajeitado
		Tooltip: Após uma longa preparação, invoca espinhos mágicos do chão
	}

	BookOfBoulders: {
		DisplayName: Livro dos Pedregulhos
		Tooltip: Conjura um pedregulho acima do cursor para esmagar seus inimigos
	}

