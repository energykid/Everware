NPCs: {
	Snapdragon.DisplayName: Snapdragon

	SculptorNPC: {
		DisplayName: Escultor
		Reliquary: Relicário
		Chisel: Cinzel
		BestiaryEntry: Um velho e sábio artista de uma época muito anterior à sua. Anos de criostase deixaram sua pele pálida, mas frio algum é capaz de apagar sua paixão pelo ofício!

		Dialogue: {
			Greeting: {
				One: Afinal, quem fica deixando aquelas estátuas de morcego por toda parte? É muito estranho esculpir a mesma coisa quinze vezes.
				Two: Deixei meu cinzel cair em algum lugar e não consigo encontrá-lo. Por acaso você o viu em algum lugar no gelo?
				Three: Eu costumava fazer esculturas de pedra na selva, mas elas sempre eram roubadas assim que eu virava as costas!
				Four: Eu sei que você tem encontrado estátuas por toda parte, mas cuidado com essa picareta. Você vai acabar danificando elas!
				Five: Sabe, algumas das peças que as pessoas vivem me mostrando são um tanto... simplórias. Eu poderia dar meu próprio toque, se quiser.
				Six: Ah, aquela do esqueleto? Não fui eu. Sério, não fui. Por que a pergunta?
			}

			TradeGreeting: {
				One: É só me mostrar uma estátua e verei o que posso fazer!
				Two: Certo, deixe-me pegar minhas ferramentas...
				Three: Outra colaboração? Esplêndido!
			}

			NoStatue: {
				One: Não tem nenhuma estátua para cinzelar, amigo.
				Two: Parece que você não tem nenhuma estátua pronta.
				Three: Vai trazer uma estátua?
			}

			InvalidStatue: {
				One: Infelizmente, não posso fazer nada com esta.
				Two: Hmm, não consigo pensar em como salvar esta aqui.
				Three: Não tem muito como melhorar este design.
			}

			AngelStatue: {
				One: Quem foi que fez isso?
				Two: Posso até ser grosseiro, mas você me toma por um bárbaro?
				Three: Quem você pensa que eu sou, um pastor?
			}

			NoMaterial: {
				One: Tive uma ideia, mas vou precisar de alguns materiais.
				Two: Uma boa base, mas vou precisar de um toque a mais!
				Three: Você sabe que eu não gosto de trabalhar com uma cor só!
			}

			WrongMaterial: {
				One: Não, não, não foi isso que eu pedi.
				Two: Você me trouxe os materiais errados!
				Three: O que é isso que você me trouxe?
			}

			NotEnoughMaterial: {
				One: Vou precisar de um pouco mais deste material.
				Two: Quero ter certeza de que os materiais não vão acabar.
				Three: Hmm, vou precisar de um pouco mais da nossa cor secundária.
			}

			SculptAnimation: {
				One: Hmm, vamos lá...
				Two: Vejamos...
				Three: Um pouco aqui, um pouco ali...
			}

			SculptAnimationFinished: {
				One: E... pronto! Aproveite!
				Two: Sim, assim está melhor!
				Three: Agora está mais do meu agrado!
			}

			TooManyStatues: {
				One: Calma aí, não consigo trabalhar em várias peças ao mesmo tempo!
				Two: Não consigo fazer tudo ao mesmo tempo assim, amigo!
				Three: Estátuas demais aí, me dê apenas uma, por favor!
			}
		}

		TownNPCMood: {
			Content: Espero que não se importe se eu trabalhar um pouco por aqui.
			NoHome: Não tenho onde colocar minhas ferramentas!
			FarFromHome: Adoro explorar, mas admito que estou com um pouco de saudade de casa.
			LoveSpace: Este é um belo espaço para trabalhar!
			DislikeCrowded: Tem barulho demais por aqui para eu conseguir me concentrar no trabalho.
			HateCrowded: Não, não, não! Não consigo fazer nada aqui! Tem barulho demais!
			LoveBiome: Ah, {BiomeName}! Ótimo lugar para ficar!
			LikeBiome: Gosto de {BiomeName}. É um bom lugar para trabalhar.
			DislikeBiome: ...{BiomeName}... Clima péssimo para alvenaria.
			HateBiome: Não posso ficar em {BiomeName}. Meu trabalho vive sendo roubado por lá!
			LoveNPC: Adoro trabalhar com {NPCName}! Talvez ele queira colaborar comigo novamente em breve?
			LikeNPC: Sabe, {NPCName} não é tão ruim. Parece até apreciar meu trabalho!
			DislikeNPC: Argh... {NPCName}. Prefiro não trabalhar perto dessa pessoa.
			HateNPC: Para alguém com uma barba tão requintada, {NPCName} NÃO tem gosto algum para arte!
			LikeNPC_Princess: Eu gosto de {NPCName}.
			Princess_LovesNPC: Eu gosto de {NPCName}.
		}
	}
}

